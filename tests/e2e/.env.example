# Documentation-only examples. Copy this file outside version control and replace every value.
E2E_OPNSENSE_URL=https://192.0.2.10
E2E_OPNSENSE_SSH=root@192.0.2.10
E2E_OPNSENSE_USERNAME=root
E2E_OPNSENSE_PASSWORD=replace-in-owner-only-copy
E2E_KEYCLOAK_URL=https://198.51.100.20:18443
# Used by every local provider; defaults to the Keycloak host.
E2E_PROVIDER_HOST=198.51.100.20
E2E_BACKCHANNEL_PORT=19443

# Optional browser-side address overrides for a prepared lab.
# E2E_OPNSENSE_BROWSER_IP=127.0.0.1
# E2E_PROVIDER_BROWSER_IP=127.0.0.1
# Optional nginx-container override; prepared labs normally retain DNS routing.
# E2E_OPNSENSE_PROXY_ADDRESS=192.0.2.10

# Optional sanitized result path; use only with one provider and one cluster.
# E2E_PROVIDER_RESULT=/absolute/owner-only/path/provider-result.json

# Optional SaaS profile. The referenced JSON itself must be mode 0600.
# E2E_LIVE_CONFIG=/absolute/owner-only/path/live-providers.json
