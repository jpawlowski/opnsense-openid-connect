{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "bash": "python3 .agents/hooks/fast_gate.py initialize",
        "cwd": ".",
        "env": {"AGENT_EXECUTION": "copilot-cloud"},
        "timeoutSec": 60
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "bash": "python3 .agents/hooks/fast_gate.py guard",
        "cwd": ".",
        "env": {"AGENT_EXECUTION": "copilot-cloud"},
        "matcher": "Bash|Edit|Write|Agent|Task",
        "timeoutSec": 60
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "bash": "python3 .agents/hooks/fast_gate.py subagent",
        "cwd": ".",
        "env": {"AGENT_EXECUTION": "copilot-cloud"},
        "timeoutSec": 3
      }
    ],
    "Stop": [
      {
        "type": "command",
        "bash": "python3 .agents/hooks/fast_gate.py stop",
        "cwd": ".",
        "env": {"AGENT_EXECUTION": "copilot-cloud"},
        "timeoutSec": 120
      }
    ],
    "SessionEnd": [
      {
        "type": "command",
        "bash": "python3 .agents/hooks/fast_gate.py cleanup",
        "cwd": ".",
        "env": {"AGENT_EXECUTION": "copilot-cloud"},
        "timeoutSec": 60
      }
    ]
  }
}
